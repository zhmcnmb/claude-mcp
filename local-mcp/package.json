{
  "name": "claude-local",
  "version": "0.2.0",
  "private": true,
  "description": "Local coding MCP server for claude.ai: read/write/edit/bash + Pi-style skills discovery",
  "type": "module",
  "bin": {
    "claude-local": "./server.ts"
  },
  "scripts": {
    "start": "node server.ts",
    "test": "node test.mjs",
    "build:app": "node build.mjs",
    "build:windows": "node build.mjs win-x64",
    "build:mac": "node build.mjs macos-arm64",
    "bundle": "node bundle.mjs",
    "desktop": "npm run bundle && electron .",
    "test:desktop": "npm run bundle && node desktop/test.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "iconv-lite": "0.7.3"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12"
  },
  "main": "desktop/main.cjs"
}
